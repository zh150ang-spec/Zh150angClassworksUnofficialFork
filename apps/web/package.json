{
  "name": "@classworks/web",
  "private": true,
  "type": "module",
  "version": "0.14.0-dev",
  "description": "适用于班级大屏的开源作业板小工具，支持记录、查看并同步作业。",
  "author": "Sunwuyuan <sun@wuyuan.dev>",
  "license": "AGPL-3.0",
  "homepage": "https://cs.houlang.cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moonrend/Classworks.git"
  },
  "bugs": {
    "url": "https://github.com/Moonrend/Classworks/issues"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:store": "node scripts/generate-sound-list.js && vite build && node scripts/validate-pwa-build.js",
    "preview": "vite preview",
    "lint": "oxlint --fix && eslint \"src/**/*.vue\" --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:check": "oxlint && eslint \"src/**/*.vue\" --cache --cache-location node_modules/.cache/.eslintcache",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:ui": "node scripts/scan-ui-issues.js",
    "pwa:validate": "node scripts/validate-pwa-build.js",
    "prebuild": "node scripts/generate-sound-list.js",
    "sync:uaf": "node scripts/sync-uaf-browser.js",
    "test:uaf": "node scripts/test-uaf-export.js"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mdi/font": "7.4.47",
    "@microsoft/clarity": "^1.0.2",
    "@sentry/vue": "^11.10.0",
    "axios": "^1.21.0",
    "idb": "^8.0.4",
    "js-base64": "^3.9.5",
    "pinia": "^4.1.0",
    "pinyin-pro": "^3.29.5",
    "ratelimit-header-parser": "^0.2.1",
    "socket.io-client": "^4.8.4",
    "typewriter-effect": "^3.3.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.3.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-vue": "^10.12.0",
    "oxlint": "^1.90.0",
    "sass": "^1.107.1",
    "sass-embedded": "^1.107.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-layouts-next": "^3.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12"
  }
}
