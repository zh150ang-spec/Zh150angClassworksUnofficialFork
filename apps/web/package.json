{
  "name": "@classworks/web",
  "private": true,
  "type": "module",
  "version": "0.12.0-beta",
  "description": "适用于班级大屏的开源作业板小工具，支持记录、查看并同步作业。",
  "author": "Sunwuyuan <sun@wuyuan.dev>",
  "license": "AGPL-3.0",
  "homepage": "https://cs.houlang.cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moonrend/Classworks.git"
  },
  "bugs": {
    "url": "https://github.com/Moonrend/Classworks/issues"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:store": "node scripts/generate-sound-list.js && vite build && node scripts/validate-pwa-build.js",
    "preview": "vite preview",
    "lint": "oxlint --fix && eslint \"src/**/*.vue\" --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "scan:ui": "node scripts/scan-ui-issues.js",
    "pwa:validate": "node scripts/validate-pwa-build.js",
    "prebuild": "node scripts/generate-sound-list.js",
    "sync:uaf": "node scripts/sync-uaf-browser.js",
    "test:uaf": "node scripts/test-uaf-export.js"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mdi/font": "7.4.47",
    "@microsoft/clarity": "^1.0.2",
    "@sentry/vue": "^10.71.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "idb": "^8.0.3",
    "js-base64": "^3.9.3",
    "pinyin-pro": "^3.29.3",
    "ratelimit-header-parser": "^0.1.0",
    "socket.io-client": "^4.8.3",
    "typewriter-effect": "^2.22.0",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.1.12",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/migrate": "^1.80.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "baseline-browser-mapping": "^2.11.20",
    "eslint": "^10.9.1",
    "eslint-plugin-oxlint": "^1.80.0",
    "eslint-plugin-vue": "^10.10.0",
    "oxlint": "^1.80.0",
    "pinia": "^4.0.3",
    "sass": "^1.103.1",
    "sass-embedded": "^1.103.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-router": "^5.3.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  }
