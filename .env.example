# Classworks KV 默认服务器域名
VITE_DEFAULT_KV_SERVER=https://kv-service.houlang.cloud

# Classworks KV 授权服务器域名
VITE_DEFAULT_AUTH_SERVER=https://kv.houlang.cloud

# 生产监控总开关（设置为 true 时启用 Sentry 和 Microsoft Clarity；默认 false）
VITE_ENABLE_MONITORING=false

# Sentry DSN（未配置时使用内置默认值）
VITE_SENTRY_DSN=

# Microsoft Clarity 项目 ID（未配置时使用内置默认值）
VITE_CLARITY_ID=
